CREATE FUNCTION {{ #SQL.WriteSchemaName }}.validate_object(p_id uuid)
RETURNS void
LANGUAGE plpgsql
AS $mycelium$
DECLARE
    kind text;
BEGIN
    -- Process all recorded removals first, regardless of deferred-event ordering.
    PERFORM {{ #SQL.WriteSchemaName }}.remove_orphans();
    SELECT {{ #SQL.WriteClassKindColumnName }} INTO kind FROM {{ #SQL.WriteSchemaName }}.{{RootTable}} WHERE {{ #SQL.WriteIdentityColumnName }} = p_id;

    IF NOT FOUND THEN
        RETURN;
    END IF;

    {{#each Tables}}
    {{#unless IsRoot}}
    IF ((kind IN ({{#if Kinds}}{{{Kinds}}}{{else}}NULL{{/if}})) IS TRUE)
        IS DISTINCT FROM (EXISTS (SELECT 1 FROM {{ #SQL.WriteSchemaName }}.{{Table}} WHERE {{ #SQL.WriteIdentityColumnName }} = p_id)) THEN
        RAISE EXCEPTION 'Inheritance rows do not match type % for %', kind, p_id USING ERRCODE = '23514';
    END IF;

    {{/unless}}
    {{/each}}
    {{#each Ownerships}}
    {{#if Required}}
    IF (kind IN ({{#if PartKinds}}{{{PartKinds}}}{{else}}NULL{{/if}})) IS TRUE
        AND NOT EXISTS (
            SELECT 1 FROM {{ #SQL.WriteSchemaName }}.{{Table}} AS relationship
            WHERE relationship.{{Part}} = p_id AND relationship.{{Owner}} IS NOT NULL
        ) THEN
        RAISE EXCEPTION 'Part % is missing a mandatory composite owner', p_id USING ERRCODE = '23514';
    END IF;

    {{/if}}
    {{/each}}
END;
$mycelium$;

CREATE FUNCTION {{ #SQL.WriteSchemaName }}.validate_inheritance()
RETURNS trigger
LANGUAGE plpgsql
AS $mycelium$
BEGIN
    IF TG_OP <> 'INSERT' THEN
        PERFORM {{ #SQL.WriteSchemaName }}.validate_object(OLD.{{ #SQL.WriteIdentityColumnName }});
    END IF;

    IF TG_OP = 'INSERT' OR (TG_OP = 'UPDATE' AND NEW.{{ #SQL.WriteIdentityColumnName }} IS DISTINCT FROM OLD.{{ #SQL.WriteIdentityColumnName }}) THEN
        PERFORM {{ #SQL.WriteSchemaName }}.validate_object(NEW.{{ #SQL.WriteIdentityColumnName }});
    END IF;

    RETURN NULL;
END;
$mycelium$;

