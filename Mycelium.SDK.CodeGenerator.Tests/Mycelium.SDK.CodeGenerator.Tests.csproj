<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0"/>
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit.Console" Version="3.22.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0"/>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.msbuild" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mycelium.SDK.CodeGenerator\Mycelium.SDK.CodeGenerator.csproj"/>
        <ProjectReference Include="..\Mycelium.SDK.Extensions\Mycelium.SDK.Extensions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Resources\*.xmi"
              Link="Resources\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <None Include="..\Resources\*.json"
              Link="Resources\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Expected\UML\**\*.cs"/>

        <None Include="Expected\UML\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <Compile Remove="Expected\OpenApi\**\*.cs"/>

        <None Include="Expected\OpenApi\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenDTO\*.cs"
              Link="Committed\Mycelium.SDK\AutoGenDTO\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenEnum\**\*"
              Link="Committed\Mycelium.SDK\AutoGenEnum\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK.Extensions\AutoGenEnumProvider\**\*"
              Link="Committed\Mycelium.SDK.Extensions\AutoGenEnumProvider\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenPOCO\*.cs"
              Link="Committed\Mycelium.SDK\AutoGenPOCO\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Committed\Mycelium.SDK.Extensions\AutoGenEnumProvider\" />
    </ItemGroup>

</Project>
