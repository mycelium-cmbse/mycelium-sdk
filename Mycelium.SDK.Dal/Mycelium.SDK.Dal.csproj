<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <LangVersion>14.0</LangVersion>
        <Version>0.4.0</Version>
        <Description>The data access layer of the Mycelium SDK: the generated PostgreSQL schema scripts.</Description>
        <PackageId>Mycelium.SDK.Dal</PackageId>
        <Company>Starion Group S.A.</Company>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-sdk.git</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <Authors>Sam Gerene, Antoine Théate, Régis André, Tanase-Marius Manafu, Omrane Haj Mohamed</Authors>
        <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
        <PackageReleaseNotes>Replaces the initial PostgreSQL schema 0001_initial.sql with the one generated from Mycelium.Model.Fabric 0.4.1 (CommonPrimitives 0.4.0), exposed through SqlSchemaScripts.GetAll(): invitation tables, a position column on the ordered Comment.replies and Review.comments link tables, value-search indexes, deferrable uniqueness constraints on Organization.name and User.externalIdentifier, and the fabric.now_utc() function. A database created from an earlier script is not upgraded and must be recreated.</PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateSBOM>true</GenerateSBOM>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Sbom.Targets"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="AutoGenSql\*.sql" LogicalName="Mycelium.SDK.Dal.AutoGenSql.%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
