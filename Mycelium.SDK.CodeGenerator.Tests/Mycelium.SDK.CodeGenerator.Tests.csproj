<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="NUnit.Console"/>
        <PackageReference Include="NUnit3TestAdapter"/>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="coverlet.msbuild"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mycelium.SDK.CodeGenerator\Mycelium.SDK.CodeGenerator.csproj"/>
        <ProjectReference Include="..\Mycelium.SDK.Extensions\Mycelium.SDK.Extensions.csproj"/>
        <ProjectReference Include="..\Mycelium.SDK.Validation\Mycelium.SDK.Validation.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Resources\*.xmi"
              Link="Resources\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <None Include="..\Resources\*.json"
              Link="Resources\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Expected\UML\**\*.cs"/>

        <None Include="Expected\UML\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <Compile Remove="Expected\OpenApi\**\*.cs"/>

        <None Include="Expected\OpenApi\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <Compile Remove="Expected\Pim\**\*.cs"/>

        <None Include="Expected\Pim\**\*.cs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenDTO\**\*"
              Link="Committed\Mycelium.SDK\AutoGenDTO\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenEnum\**\*"
              Link="Committed\Mycelium.SDK\AutoGenEnum\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK.Extensions\AutoGenEnumProvider\**\*"
              Link="Committed\Mycelium.SDK.Extensions\AutoGenEnumProvider\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK\AutoGenPOCO\**\*"
              Link="Committed\Mycelium.SDK\AutoGenPOCO\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK.Validation\AutoGenDtoValidator\**\*"
              Link="Committed\Mycelium.SDK.Validation\AutoGenDtoValidator\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK.Serializer.Json\AutoGenSerializer\**\*"
              Link="Committed\Mycelium.SDK.Serializer.Json\AutoGenSerializer\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Mycelium.SDK.Serializer.Json\AutoGenDeSerializer\**\*"
              Link="Committed\Mycelium.SDK.Serializer.Json\AutoGenDeSerializer\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Committed\Mycelium.SDK.Extensions\AutoGenEnumProvider\"/>
    </ItemGroup>

</Project>
