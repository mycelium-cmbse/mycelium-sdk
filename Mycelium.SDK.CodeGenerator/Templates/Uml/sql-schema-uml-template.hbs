-- Capture detached identities immediately; delete them only after reparenting
-- can finish. The private queue is transaction-local, including savepoint rollback.
CREATE FUNCTION {{ #SQL.WriteSchemaName }}.track_ownership()
RETURNS trigger
LANGUAGE plpgsql
AS $mycelium$
DECLARE
    old_part uuid;
    new_part uuid;
    old_owner uuid;
    new_owner uuid;
    part_id uuid;
    pending jsonb;
BEGIN
    IF TG_OP <> 'INSERT' THEN
        old_part := (to_jsonb(OLD) ->> TG_ARGV[0])::uuid;
        old_owner := (to_jsonb(OLD) ->> TG_ARGV[1])::uuid;
    END IF;

    IF TG_OP <> 'DELETE' THEN
        new_part := (to_jsonb(NEW) ->> TG_ARGV[0])::uuid;
        new_owner := (to_jsonb(NEW) ->> TG_ARGV[1])::uuid;
    END IF;

    IF TG_OP = 'UPDATE' AND old_part IS NOT DISTINCT FROM new_part AND old_owner IS NOT DISTINCT FROM new_owner THEN
        RETURN NULL;
    END IF;

    FOR part_id IN
        SELECT DISTINCT candidate
        FROM unnest(ARRAY[old_part, new_part]) AS affected(candidate)
        WHERE candidate IS NOT NULL
        ORDER BY candidate
    LOOP
        PERFORM {{ #SQL.WriteSchemaName }}.lock_object(part_id);
    END LOOP;

    IF old_part IS NOT NULL AND old_owner IS NOT NULL THEN
        pending := COALESCE(NULLIF(current_setting('mycelium.fabric_detached_parts', true), ''), '[]')::jsonb;
        PERFORM set_config('mycelium.fabric_detached_parts', (pending || jsonb_build_array(old_part))::text, true);
    END IF;

    RETURN NULL;
END;
$mycelium$;

CREATE FUNCTION {{ #SQL.WriteSchemaName }}.remove_orphans()
RETURNS void
LANGUAGE plpgsql
AS $mycelium$
DECLARE
    pending jsonb;
    part_id uuid;
BEGIN
    LOOP
        pending := COALESCE(NULLIF(current_setting('mycelium.fabric_detached_parts', true), ''), '[]')::jsonb;
        EXIT WHEN pending = '[]'::jsonb;
        PERFORM set_config('mycelium.fabric_detached_parts', '[]', true);

        FOR part_id IN
            SELECT DISTINCT value::uuid FROM jsonb_array_elements_text(pending) ORDER BY 1
        LOOP
            PERFORM {{ #SQL.WriteSchemaName }}.lock_object(part_id);

            IF NOT EXISTS (SELECT 1 FROM {{ #SQL.WriteSchemaName }}.owners(part_id)) THEN
                DELETE FROM {{ #SQL.WriteSchemaName }}.{{RootTable}} WHERE {{ #SQL.WriteIdentityColumnName }} = part_id;
            END IF;
        END LOOP;
        -- Cascaded deletion may have queued further contained objects.
    END LOOP;
END;
$mycelium$;

CREATE FUNCTION {{ #SQL.WriteSchemaName }}.check_ownership(p_part uuid)
RETURNS void
LANGUAGE plpgsql
AS $mycelium$
BEGIN
    IF p_part IS NULL THEN
        RETURN;
    END IF;

    -- Reacquire protection when references were inserted before their deferred root.
    PERFORM {{ #SQL.WriteSchemaName }}.lock_object(p_part);

    IF (SELECT count(DISTINCT owner_id) FROM {{ #SQL.WriteSchemaName }}.owners(p_part)) > 1 THEN
        RAISE EXCEPTION 'Part % has multiple composite owners', p_part USING ERRCODE = '23505';
    END IF;
END;
$mycelium$;

CREATE FUNCTION {{ #SQL.WriteSchemaName }}.validate_ownership()
RETURNS trigger
LANGUAGE plpgsql
AS $mycelium$
DECLARE
    old_part uuid;
    new_part uuid;
    old_owner uuid;
    new_owner uuid;
BEGIN
    IF TG_OP <> 'INSERT' THEN
        old_part := (to_jsonb(OLD) ->> TG_ARGV[0])::uuid;
        old_owner := (to_jsonb(OLD) ->> TG_ARGV[1])::uuid;
    END IF;

    IF TG_OP <> 'DELETE' THEN
        new_part := (to_jsonb(NEW) ->> TG_ARGV[0])::uuid;
        new_owner := (to_jsonb(NEW) ->> TG_ARGV[1])::uuid;
    END IF;

    IF TG_OP = 'UPDATE' AND old_part IS NOT DISTINCT FROM new_part AND old_owner IS NOT DISTINCT FROM new_owner THEN
        RETURN NULL;
    END IF;

    PERFORM {{ #SQL.WriteSchemaName }}.remove_orphans();
    PERFORM {{ #SQL.WriteSchemaName }}.check_ownership(old_part);

    IF new_part IS DISTINCT FROM old_part THEN
        PERFORM {{ #SQL.WriteSchemaName }}.check_ownership(new_part);
    END IF;

    RETURN NULL;
END;
$mycelium$;

