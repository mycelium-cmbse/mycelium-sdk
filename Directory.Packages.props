<?xml version="1.0" encoding="utf-8"?>

<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!--
        Use lowest compatible library versions; update for required APIs or security fixes.
        Keep serialization/crypto current within approved compatibility.
        Deliberate floor: Microsoft.Extensions.Logging.Abstractions (.NET 8 LTS; sufficient APIs).
        Exclude floors only from outdated checks; retain deprecated/vulnerable checks.
    -->
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
        <PackageVersion Include="FluentValidation" Version="12.2.0" />
        <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
        <PackageVersion Include="MessagePack" Version="3.1.12" />
        <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
        <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
        <PackageVersion Include="Mycelium.Model.CommonPrimitives" Version="0.4.0" />
        <PackageVersion Include="Mycelium.Model.Fabric" Version="0.2.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Console" Version="3.22.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="System.Text.Json" Version="10.0.14" />
        <PackageVersion Include="uml4net.HandleBars" Version="9.2.0" />
        <PackageVersion Include="uml4net.xmi" Version="9.2.0" />
        <PackageVersion Include="uml4net.xmi.Extensions.EnterpriseArchitect" Version="9.2.0" />
    </ItemGroup>

</Project>
