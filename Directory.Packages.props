<?xml version="1.0" encoding="utf-8"?>

<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!--
        Libraries use the lowest supported versions providing the required APIs.
        Raise stable framework-abstraction LTS floors only for required APIs or affected vulnerabilities.
        Keep serialization and cryptography dependencies current within approved compatibility contracts.
        Preserve other versions during CPM migration; do not mass-upgrade tooling, tests or benchmarks.

        Deliberately floored: Microsoft.Extensions.Logging.Abstractions (compatible .NET 8 LTS logging APIs).
        Mirror this list only in the workflow's outdated exclusions; retain deprecated and vulnerable checks.
    -->
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
        <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
        <PackageVersion Include="FluentValidation" Version="11.12.0" />
        <PackageVersion Include="Humanizer.Core" Version="2.14.1" />
        <PackageVersion Include="MessagePack" Version="3.1.8" />
        <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.3.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
        <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
        <PackageVersion Include="Mycelium.Model.CommonPrimitives" Version="0.4.0" />
        <PackageVersion Include="Mycelium.Model.Fabric" Version="0.2.0" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit.Console" Version="3.22.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="System.Text.Json" Version="10.0.9" />
        <PackageVersion Include="uml4net.HandleBars" Version="8.3.0" />
        <PackageVersion Include="uml4net.xmi" Version="8.5.1" />
        <PackageVersion Include="uml4net.xmi.Extensions.EnterpriseArchitect" Version="8.6.1" />
    </ItemGroup>

</Project>
