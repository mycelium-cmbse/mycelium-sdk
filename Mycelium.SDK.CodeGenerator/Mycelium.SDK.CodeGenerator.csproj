<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>The code generator for the Mycelium SDK.</Description>
        <Company>Starion Group S.A.</Company>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-sdk.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Authors>Sam Gerene, Antoine Théate, Régis André, Tanase-Marius Manafu, Omrane Haj Mohamed</Authors>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer.Core" Version="2.14.1"/>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0"/>
        <PackageReference Include="Microsoft.OpenApi" Version="3.10.2"/>
        <PackageReference Include="Mycelium.Model.CommonPrimitives" Version="0.4.0"/>
        <PackageReference Include="Mycelium.Model.Fabric" Version="0.2.0"/>
        <PackageReference Include="uml4net.HandleBars" Version="8.3.0"/>
        <PackageReference Include="uml4net.xmi.Extensions.EnterpriseArchitect" Version="8.6.1"/>
        <PackageReference Include="uml4net.xmi" Version="8.5.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MyceliumModelFabricXmiPath)" Link="Resources\mycelium-fabric.xmi" Condition="'$(MyceliumModelFabricXmiPath)' != ''">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="$(MyceliumModelCommonPrimitivesXmiPath)" Link="Resources\mycelium-commonprimitives.xmi" Condition="'$(MyceliumModelCommonPrimitivesXmiPath)' != ''">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="Templates\Uml\dto-class-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\dto-interface-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\enumeration-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\enumprovider-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\json-dto-serializer-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\json-dto-serialization-provider-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\Partials\json-dto-serializer-uml-partial-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\json-dto-deserializer-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\json-dto-deserialization-provider-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\json-enum-deserializer-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\Partials\json-dto-deserializer-uml-partial-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\dto-messagepackformatter-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\enum-messagepackformatter-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\messagepack-dataresolver-getformatter-helper.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\messagepack-payload-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\messagepack-payloadfactory-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\messagepack-payloadmessagepackformatter-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\poco-interface-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Uml\poco-class-uml-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\OpenApi\carter-module-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Pim\service-interface-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Templates\Pim\repository-interface-template.hbs">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
